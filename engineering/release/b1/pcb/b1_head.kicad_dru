(version 1)
(rule "B1 minimum clearance" (constraint clearance (min 0.15mm)))
(rule "B1 copper to edge" (constraint edge_clearance (min 0.15mm)))
(rule "B1 track width" (constraint track_width (min 0.15mm)))
(rule "B1 via drill" (constraint hole_size (min 0.20mm)))
(rule "B1 plated via diameter" (constraint via_diameter (min 0.45mm)))
